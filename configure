#!/bin/sh
# Check that GEOS is present and new enough for the coverage API,
# then guarantee src/Makevars exists.
#
# src/Makevars is committed, because devtools::load_all() and
# R CMD SHLIB never run this script and need the flags anyway. But it
# is rewritten here too, so a missing or stale copy cannot survive an
# install. Without those flags the link SUCCEEDS with undefined GEOS
# symbols and only fails later at load time, which is a miserable
# thing to debug.
#
# Override discovery with GEOS_CONFIG=/path/to/geos-config.

GEOS_CONFIG=${GEOS_CONFIG:-geos-config}

if ! "${GEOS_CONFIG}" --version >/dev/null 2>&1; then
  echo "------------------------- ERROR -------------------------"
  echo "geos-config was not found on PATH."
  echo ""
  echo "cvr needs the GEOS C library and headers, version 3.12.0"
  echo "or later (that is when the coverage API was added)."
  echo ""
  echo "  Debian/Ubuntu:  apt-get install libgeos-dev"
  echo "  Fedora:         dnf install geos-devel"
  echo "  macOS:          brew install geos"
  echo ""
  echo "If geos-config is installed somewhere else, set GEOS_CONFIG"
  echo "to its full path and reinstall."
  echo "---------------------------------------------------------"
  exit 1
fi

GEOS_VERSION=`"${GEOS_CONFIG}" --version`
GEOS_MAJOR=`echo "${GEOS_VERSION}" | cut -d. -f1`
GEOS_MINOR=`echo "${GEOS_VERSION}" | cut -d. -f2`

if [ "${GEOS_MAJOR}" -lt 3 ] || { [ "${GEOS_MAJOR}" -eq 3 ] && [ "${GEOS_MINOR}" -lt 12 ]; }; then
  echo "------------------------- ERROR -------------------------"
  echo "Found GEOS ${GEOS_VERSION}, but cvr needs 3.12.0 or later."
  echo "GEOSCoverageSimplifyVW, GEOSCoverageIsValid and"
  echo "GEOSCoverageUnion were added in 3.12.0."
  echo "---------------------------------------------------------"
  exit 1
fi

cat > src/Makevars <<EOF
# Written by ./configure. A committed copy is also kept in the repo
# for build paths that never run configure (devtools::load_all(),
# R CMD SHLIB). Do not add a 'cleanup' script that deletes this file.
GEOS_CONFIG ?= ${GEOS_CONFIG}
PKG_CPPFLAGS = \$(shell \$(GEOS_CONFIG) --cflags)
PKG_LIBS = \$(shell \$(GEOS_CONFIG) --clibs)
EOF

echo "cvr: using GEOS ${GEOS_VERSION} (${GEOS_CONFIG})"
exit 0
